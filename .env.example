# ========================================================
# SAFE SPACE - SUPABASE CONFIGURATION
# ========================================================
# Copy your project credentials from your Supabase Dashboard:
# Supabase Dashboard -> Project Settings -> API

# 1. Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public / Anon API Key (safe to use in web clients with RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# To configure in the app, open: js/config.js
# Paste SUPABASE_URL and SUPABASE_ANON_KEY there.
# If left blank, Safe Space automatically runs in Local Demo Mode!
